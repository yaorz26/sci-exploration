{"problem_id": "apps-train-2009", "selection": {"selected_candidate_id": "apps-train-2009:d0:c0", "selection_rule": "highest public pass rate, then lowest decomposition and combination index", "private_fields_used": [], "candidates": [{"candidate_id": "apps-train-2009:d0:c0", "problem_id": "apps-train-2009", "decomposition_index": 0, "combination_index": 0, "implementation_indices": {"calculate_magnitude": 0, "check_position": 0, "find_sequence": 0, "solve": 0}, "compose": {"valid": true, "errors": [], "definitions": 4, "imports": 1, "syntax_valid": true, "api_preserved": true, "function_order": ["calculate_magnitude", "check_position", "find_sequence", "solve"]}, "code": "from __future__ import annotations\nimport math\n\ndef calculate_magnitude(x, y):\n    return math.sqrt(x ** 2 + y ** 2)\n\ndef check_position(position, max_magnitude):\n    return calculate_magnitude(position[0], position[1]) <= max_magnitude\n\ndef find_sequence(vectors):\n    n = len(vectors)\n    signs = [1] * n\n    position = [0, 0]\n    max_magnitude = 1.5 * 10 ** 6\n    for i in range(n):\n        if not check_position(position, max_magnitude):\n            signs[i] = -1\n            position[0] -= vectors[i][0]\n            position[1] -= vectors[i][1]\n        else:\n            position[0] += vectors[i][0]\n            position[1] += vectors[i][1]\n    return signs\n\ndef solve():\n    n = int(input())\n    vectors = [tuple(map(int, input().split())) for _ in range(n)]\n    signs = find_sequence(vectors)\n    print(' '.join(map(str, signs)))\nif __name__ == '__main__':\n    solve()\n", "code_hash": "a47ee2da56d6bfc2772a8f526cba8600ed83f7f7f11edc50c4d030af24d3ded0", "public": {"split": "public", "passed": 1, "total": 9, "pass_rate": 0.1111111111111111, "tests": [{"passed": 0, "expected": "1 1 -1 \n", "actual": "1 1 1\n", "stderr": "", "error_type": "wrong_answer", "message": "output mismatch", "timeout": false, "duration_seconds": 0.032125}, {"passed": 1, "expected": "1 \n", "actual": "1