{"problem_id": "apps-train-2658", "selection": {"selected_candidate_id": "apps-train-2658:c1", "selection_rule": "highest public pass rate, then lowest candidate index", "private_fields_used": [], "candidates": [{"candidate_id": "apps-train-2658:c0", "candidate_index": 0, "contract_hash": "ff857e9c2a64ec98c945b0fce8d3e075925746a2459dbd9c12274943efa38bb3", "contract_valid": true, "program_conformant": false, "code": null, "code_hash": null, "public": null}, {"candidate_id": "apps-train-2658:c1", "candidate_index": 1, "contract_hash": "fca52903c80e22bd311027e04f3d778b130ab56d9027b861fcfcde040778366a", "contract_valid": true, "program_conformant": true, "code": "def convert_bits(a: int, b: int) -> int:\n    \"\"\"\n    Determine the number of bits required to convert integer A to integer B.\n    Inputs: a (int), b (int)\n    Output: int\n    Algorithmic role: Entry point for the conversion process.\n    \"\"\"\n    return count_set_bits(xor_bits(a, b))\n\ndef xor_bits(a: int, b: int) -> int:\n    \"\"\"\n    Compute the XOR of two integers.\n    Inputs: a (int), b (int)\n    Output: int\n    Algorithmic role: Helper function to find differing bits between A and B.\n    \"\"\"\n    return a ^ b\n\ndef count_set_bits(n: int) -> int:\n    \"\"\"\n    Count the number of set bits (1s) in an integer.\n    Inputs: n (int)\n    Output: int\n    Algorithmic role: Helper function to count the number of bits that need to be flipped.\n    \"\"\"\n    count = 0\n    while n:\n        count += n & 1\n        n >>= 1\n    return count\n", "code_hash": "74ba5cb5a80b1617aa280e23caacfadcdab64d3fae45b20f3d87ea07a0745126", "public": {"split": "public", "passed": 3, "total": 3, "pass_rate": 1.0, "tests": [{"passed": 1, "expected": "[2]", "actual": "2\n", "stderr": "", "error_type": null, "message": "", "timeout": false, "duration_seconds": 0.105958}, {"passed": 1, "expected": "[3]", "actual": "3\n", "stderr": "", "error_type": null, "message": "", "timeout": false, "duration_seconds": 0.0