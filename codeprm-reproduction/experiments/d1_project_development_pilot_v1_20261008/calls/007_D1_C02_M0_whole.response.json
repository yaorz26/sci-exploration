  "response": "```python\ndef solve(payload):\n    capacity = payload['capacity']\n    ttl = payload['ttl']\n    operations = payload['operations']\n    \n    class CacheItem:\n        def __init__(self, key, value, time, ttl):\n            self.key = key\n            self.value = value\n            self.time = time\n            self.ttl = ttl\n            self.expiry_time = time + ttl\n        \n        def is_expired(self, time):\n            return time >= self.expiry_time\n    \n    class Cache:\n        def __init__(self, capacity):\n            self.capacity = capacity\n            self.items = {}\n            self.order = []\n        \n        def put(self, key, value, time):\n            if self.capacity == 0:\n                return {'error': 'ValueError'}\n            if key in self.items:\n                self._remove(key)\n            if len(self.items) >= self.capacity:\n                self._evict()\n            self.items[key] = CacheItem(key, value, time, ttl)\n            self.order.append(key)\n            return None\n        \n        def get(self, key, time):\n            if key not in self.items:\n                return {'error': 'KeyError'}\n            item = self.items[key]\n            if item.is_expired(time):\n                self._remove(key)\n                return {'error': 'KeyError'}\n            self.order.remove(key)\n            self.order.append(key)\n            return item.value\n        \n        def delete(self, key):\n            if key in self.items:\n                self._remove(key)\n                return None\n            return {'error': 'KeyError'}\n        \n        def contains(self, key):\n            if key in self.items:\n                item = self.items[key]\n                if item.is_expired(time):\n                    self._remove(key)\n                    return False\n                return True\n            return False\n        \n        def clear(self):\n            self.items.clear()\n            self.