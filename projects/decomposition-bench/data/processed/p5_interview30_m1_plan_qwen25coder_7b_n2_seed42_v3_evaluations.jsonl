{"problem_id": "apps-train-1604", "selection": {"selected_candidate_id": "apps-train-1604:c0", "selection_rule": "highest public pass rate, then lowest candidate index", "private_fields_used": [], "candidates": [{"candidate_id": "apps-train-1604:c0", "candidate_index": 0, "code": "MOD = 10**9 + 7\n\ndef count_paths(n, m, labyrinth):\n    dp = [[0] * m for _ in range(n)]\n    dp[0][0] = 1\n    \n    for i in range(n):\n        for j in range(m):\n            if labyrinth[i][j] == 'R':\n                continue\n            if i > 0:\n                dp[i][j] = (dp[i][j] + dp[i-1][j]) % MOD\n            if j > 0:\n                dp[i][j] = (dp[i][j] + dp[i][j-1]) % MOD\n    \n    return dp[n-1][m-1]\n\nimport sys\ninput = sys.stdin.read\ndata = input().split()\n\nn = int(data[0])\nm = int(data[1])\nlabyrinth = data[2:]\n\nprint(count_paths(n, m, labyrinth))\n", "code_hash": "982f73938771538b11670424b25bda9030f3482914d07005c37cc75d93d49783", "public": {"split": "public", "passed": 2, "total": 3, "pass_rate": 0.6666666666666666, "tests": [{"passed": 1, "expected": "1\n", "actual": "1\n", "stderr": "", "error_type": null, "message": "", "timeout": false, "duration_seconds": 0.033264}, {"passed": 1, "expected": "0\n", "actual": "0\n", "stderr": "", "error_type": null, "message": "", "timeout": false, "duration_seconds": 0.033276}, {"passed": 0, "expected": "4\n", "actual": "0\n", "stderr": "", "error_type": "wrong_answer", "message": "output mismatch", "timeout": false, "duration_seconds": 0.031096}]}}, {"candidate_id": "apps-train-1604:c1", "candidate_index": 1, "code": "MOD = 10**9 + 7\n\ndef count_paths(n, m, labyrinth):\n    dp = [[0] * (m + 1) for _ in range(n + 1)]\n    dp[1][1] = 1\n\n    for i in range(1, n + 1):\n        for j in range(1, m + 1):\n            if labyrinth[i-1][j-1] == 'R':\n                continue\n            dp[i][j] = (dp[i-1][j] + dp[i][j-1]) % MOD\n\n    return dp[n][m]\n\nif __name__ == \"__main__\":\n    import sys\n    input = sys.stdin