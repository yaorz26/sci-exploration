{
  "integration": [
    {
      "id": "sort_full_key_domain_filter_not_prefix",
      "input": {
        "columns": [
          [
            2,
            1
          ],
          [
            "a"
          ]
        ],
        "keys": [
          0
        ]
      },
      "expected": {
        "value": [
          [
            2
          ],
          [
            "a"
          ]
        ]
      }
    },
    {
      "id": "reverse_filters_invalid_key_rows",
      "input": {
        "columns": [
          [
            1,
            2
          ],
          [
            "a"
          ]
        ],
        "reverse": true
      },
      "expected": {
        "value": [
          [
            1
          ],
          [
            "a"
          ]
        ]
      }
    },
    {
      "id": "stable_equal_keys",
      "input": {
        "columns": [
          [
            1,
            1,
            1
          ],
          [
            "a",
            "b",
            "c"
          ]
        ]
      },
      "expected": {
        "value": [
          [
            1,
            1,
            1
          ],
          [
            "a",
            "b",
            "c"
          ]
        ]
      }
    },
    {
      "id": "strict_mismatch",
      "input": {
        "columns": [
          [
            2,
            1
          ],
          [
            "a"
          ]
        ],
        "strict": true
      },
      "expected": {
        "error": "ValueError"
      }
    },
    {
      "id": "empty_common_domain",
      "input": {
        "columns": [
          [
            2,
            1
          ],
          []
        ]
      },
      "expected": {
        "value": []
      }
    },
    {
      "id": "multiple_keys",
      "input": {
        "columns": [
          [
            1,
            1,
            0
          ],
          [
            2,
            1,
            3
          ],
          [
            "a",
            "b"
          ]
        ],
        "keys": [
          0,
          1
        ]
      },
      "expected": {
        "value": [
          [
            1,
            1
          ],
          [
            1,
            2
          ],
          [
            "b",
            "a"
          ]
        ]
      }
    },
    {
      "id": "second_key_column",
      "input": {
        "columns": [
          [
            "a"
          ],
          [
            2,
            1
          ]
        ],
        "keys": [
          1
        ]
      },
      "expected": {
        "value": [
          [
            "a"
          ],
          [
            2
          ]
        ]
      }
    }
  ],
  "local": [
    {
      "helper": "_domain",
      "args": [
        {
          "columns": [
            [
              2,
              1
            ],
            [
              "a"
            ]
          ]
        }
      ],
      "expected": {
        "value": [
          1,
          2,
          [
            0
          ],
          false
        ]
      }
    },
    {
      "helper": "_domain",
      "args": [
        {
          "columns": [
            [
              2,
              1
            ],
            [
              "a"
            ]
          ],
          "strict": true
        }
      ],
      "expected": {
        "error": "ValueError"
      }
    },
    {
      "helper": "_domain",
      "args": [
        {
          "columns": [
            [
              2,
              1
            ],
            []
          ]
        }
      ],
      "expected": {
        "value": [
          0,
          2,
          [
            0
          ],
          false
        ]
      }
    },
    {
      "helper": "_order",
      "args": [
        [
          [
            2,
            1
          ],
          [
            "a"
          ]
        ],
        [
          0
        ],
        2,
        false
      ],
      "expected": {
        "value": [
          1,
          0
        ]
      }
    },
    {
      "helper": "_order",
      "args": [
        [
          [
            2,
            1
          ],
          [
            "a"
          ]
        ],
        [
          0
        ],
        1,
        false
      ],
      "expected": {
        "value": [
          0
        ]
      }
    },
    {
      "helper": "_order",
      "args": [
        [
          [
            1,
            1
          ],
          [
            "a",
            "b"
          ]
        ],
        [
          0
        ],
        2,
        true
      ],
      "expected": {
        "value": [
          0,
          1
        ]
      }
    }
  ]
}