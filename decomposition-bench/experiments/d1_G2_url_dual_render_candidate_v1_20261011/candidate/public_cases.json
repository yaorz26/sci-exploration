{
  "task": "URL 同一次解析的两种渲染用途（K3 项目内不同用途候选）",
  "domain": "以 http/https 开头、含查询串的有限 URL；查询项为普通键值；不含用户信息与 IPv6",
  "expected_derivation": "按 requirement.md 的公开义务逐条手写推导；不运行实现后回填",
  "cases": [
    {
      "id": "query_values_and_order",
      "input": "https://example.com/find?a=1&b=2&a=3",
      "keys": ["a", "b", "a"],
      "items": [["a", "1"], ["b", "2"], ["a", "3"]],
      "get": {"key": "a", "expected": "1"},
      "getlist": {"key": "a", "expected": ["1", "3"]},
      "to_text_minimal": "https://example.com/find?a=1&b=2&a=3",
      "to_text_full": "https://example.com/find?a=1&b=2&a=3"
    },
    {
      "id": "already_encoded_preserved",
      "input": "http://h/p?q=a%20b",
      "keys": ["q"],
      "items": [["q", "a%20b"]],
      "get": {"key": "q", "expected": "a%20b"},
      "getlist": {"key": "q", "expected": ["a%20b"]},
      "to_text_minimal": "http://h/p?q=a%20b",
      "to_text_full": "http://h/p?q=a%20b",
      "note": "已存在的百分号编码在两种用途下都不重复编码（两种模式都保留 %25 前的字面 % 序列）"
    },
    {
      "id": "reserved_chars_encoding",
      "input": "http://h/p?a=%2Fx%3Fy&b=z",
      "keys": ["a", "b"],
      "items": [["a", "%2Fx%3Fy"], ["b", "z"]],
      "get": {"key": "a", "expected": "%2Fx%3Fy"},
      "getlist": {"key": "a", "expected": ["%2Fx%3Fy"]},
      "to_text_minimal": "http://h/p?a=%2Fx%3Fy&b=z",
      "to_text_full": "http://h/p?a=%2Fx%3Fy&b=z"
    },
    {
      "id": "plus_is_not_space",
      "input": "http://h/s?q=a+b",
      "keys": ["q"],
      "items": [["q", "a+b"]],
      "get": {"key": "q", "expected": "a+b"},
      "getlist": {"key": "q", "expected": ["a+b"]},
      "to_text_minimal": "http://h/s?q=a+b",
      "to_text_full": "http://h/s?q=a+b",
      "note": "映射视图与渲染都把 '+' 当字面加号；不得还原成空格"
    },
    {
      "id": "space_in_path_and_fragment",
      "input": "http://h/files/report 1.pdf#note one",
      "keys": [],
      "items": [],
      "get": {"key": "missing", "expected": null},
      "getlist": {"key": "missing", "expected": []},
      "to_text_minimal": "http://h/files/report 1.pdf#note one",
      "to_text_full": "http://h/files/report%201.pdf#note%20one"
    }
  ]
}
